{
  "name": "black-carteira-api",
  "version": "0.1.0",
  "private": true,
  "description": "API multi-tenant para carteira de clientes, metas e atendimento via WhatsApp",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/api/server.js",
    "worker": "node dist/worker/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "cross-env RUN_INTEGRATION=true vitest run tests/integration --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "11.3.0",
    "@prisma/client": "6.12.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "argon2": "0.45.2",
    "bullmq": "6.7.10",
    "exceljs": "^4.4.0",
    "fastify": "5.12.8",
    "ioredis": "5.8.2",
    "jose": "6.1.2",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "7.0.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.7.4",
    "prisma": "6.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.7": true,
    "prisma@6.12.0": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "@whiskeysockets/baileys@6.7.24": true,
    "protobufjs@7.6.6": true
  }
}
