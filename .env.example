# Aplicação
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
API_BASE_URL=http://localhost:3000

# PostgreSQL e Redis
DATABASE_URL=postgresql://black_carteira:black_carteira_local@localhost:5432/black_carteira?schema=public
REDIS_URL=redis://localhost:6379

# JWT: gere valores aleatórios com pelo menos 32 caracteres
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-de-no-minimo-32-caracteres
JWT_ISSUER=black-carteira-api
JWT_AUDIENCE=black-carteira-painel
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# CORS: origens separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Limites globais da API
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute

# Seed local (não usar em produção)
SEED_PASSWORD=troque-esta-senha-local

# Fases futuras (mantenha vazio até configurar o provedor)
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
TOKEN_ENCRYPTION_KEY=
